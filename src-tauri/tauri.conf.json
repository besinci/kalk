{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalk",
  "version": "0.4.0",
  "identifier": "io.github.besinci.kalk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalk",
        "width": 340,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "10 squats every 45 minutes",
    "longDescription": "Kalk sits in your tray and reminds you to do 10 bodyweight squats after every 45 minutes of active computer use.",
    "copyright": "© 2026 besinci",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNjc0RjcxNTZGNDE4QTAKUldTZ0dQUldjVTluQTRDNXoyQzc4cldKV21aMlR0S2didG9FZzhyU3BINENLZDVGampFSTJub2YK",
      "endpoints": [
        "https://github.com/besinci/kalk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
